{
  "name": "Flutter Template Development",
  "build": {
    "dockerfile": "../src/flutter/Dockerfile",
    "context": "../src/flutter"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "github.vscode-github-actions"
      ],
      "settings": {
        "dart.flutterSdkPath": "/home/vscode/flutter",
        "dart.sdkPath": "/home/vscode/flutter/bin/cache/dart-sdk",
        "launch": {
          "version": "0.2.0",
          "configurations": [
            {
              "name": "Flutter Web (headless Chrome)",
              "type": "dart",
              "request": "launch",
              "program": "${workspaceFolder}/lib/main.dart",
              "deviceId": "chrome",
              "toolArgs": [
                "--web-hostname=0.0.0.0",
                "--web-port=3000",
                "--web-browser-flag=--headless=new",
                "--web-browser-flag=--disable-dev-shm-usage"
              ]
            },
            {
              "name": "Flutter Web (browser preview)",
              "type": "dart",
              "request": "launch",
              "program": "${workspaceFolder}/lib/main.dart",
              "deviceId": "web-server",
              "toolArgs": [
                "--web-hostname=0.0.0.0",
                "--web-port=3000"
              ]
            }
          ]
        }
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "flutter --version",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Flutter Web",
      "onAutoForward": "notify"
    }
  },
  "runArgs": [
    "--security-opt=seccomp=${localWorkspaceFolder}/src/flutter/.devcontainer/chromium-seccomp.json"
  ]
}
